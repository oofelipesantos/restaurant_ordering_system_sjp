{
  "name": "restaurant_ordering_system",
  "version": "1.0.0",
  "description": "API REST para gerenciamento de categorias, produtos, pedidos e itens de pedidos de um restaurante",
  "keywords": [
    "back-end",
    "ts",
    "js",
    "API",
    "restaurant",
    "ordering",
    "microservice"
  ],
  "homepage": "https://github.com/oofelipesantos/restaurant_ordering_system_sjp#readme",
  "bugs": {
    "url": "https://github.com/oofelipesantos/restaurant_ordering_system_sjp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oofelipesantos/restaurant_ordering_system_sjp.git"
  },
  "license": "ISC",
  "author": "Felipe Santos",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run src/tests/unit",
    "test:integration": "vitest run src/tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "node --watch --env-file=.env --import=tsx/esm src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.0.14",
    "supertest": "^7.1.4",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "express": "^5.3.0",
    "swagger-ui-express": "^5.0.1"
  }
}
